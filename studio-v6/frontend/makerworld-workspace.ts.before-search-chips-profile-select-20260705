      .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(235px,1fr));gap:14px;margin-top:16px}.card{position:relative;overflow:hidden;border:1px solid #2a3c53;border-radius:12px;background:#101925;cursor:context-menu;transition:border-color .15s,transform .15s,box-shadow .15s}.card:hover{border-color:#46bff6;transform:translateY(-2px);box-shadow:0 12px 28px #0005}.image{display:grid;place-items:center;width:100%;aspect-ratio:4/3;background:linear-gradient(145deg,#121c28,#1b2b3b);overflow:hidden}.image img{width:100%;height:100%;object-fit:cover}.fallback{font-size:52px;color:#6284a2}.body{padding:11px}.title{display:-webkit-box;min-height:2.5em;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:2;font-weight:800;line-height:1.25}.creator{margin-top:5px;color:#91a5bb;font-size:12px}.stats{display:flex;gap:9px;flex-wrap:wrap;margin-top:9px;color:#7f96ac;font-size:11px}.tags{display:flex;gap:4px;flex-wrap:wrap;margin-top:8px}.tag{padding:2px 6px;border-radius:999px;background:#ffffff0b;color:#9eb2c7;font-size:10px}.card-actions{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:10px}.card-actions button{padding:7px;font-size:11px}.menu{position:absolute;z-index:3;top:8px;right:8px;width:31px;height:29px;padding:0;border:1px solid #4a7193;border-radius:7px;background:#07121dcc;color:#fff;cursor:pointer}.load-row{display:grid;place-items:center;margin-top:16px}
