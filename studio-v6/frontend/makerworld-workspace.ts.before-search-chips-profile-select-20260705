    page.id = "page";
    this.#root.replaceChildren(style, page);
    this.#render();
  }

  async #load(reset: boolean): Promise<void> {
    if (this.#loading) return;
    this.#loading = true;
    this.#error = "";
    if (reset) this.#offset = 0;
    this.#render();
    try {
      const result = await this.#api.browse(this.#query, this.#navKey, this.#offset, 24);
      this.#items = reset ? result.items : [...this.#items, ...result.items.filter((item) => !this.#items.some((existing) => existing.id === item.id))];
      this.#hasMore = result.has_more;
      this.#offset = result.offset + result.items.length;
    } catch (error) {
      this.#error = errorMessage(error);
      if (reset) this.#items = [];
    } finally {
      this.#loading = false;
      this.#render();
    }
  }

  #render(): void {
    const page = this.#root.querySelector<HTMLElement>("#page");
    if (!page) return;
    page.innerHTML = `
      <section class="hero"><div><h1>MakerWorld</h1><p>Direkte Modellübersicht mit Vorschaubildern, Druckprofilen, Platten und Übergabe in Galerie, CAD-Studio oder Slicer.</p></div><div class="brand">Maker<br>World</div></section>
      <form class="search" id="search-form"><input id="query" type="search" placeholder="MakerWorld durchsuchen …" value="${escapeHtml(this.#query)}"><button class="button primary" type="submit">Suchen</button></form>
      <nav class="nav">${NAVIGATION.map((item) => `<button type="button" data-nav="${escapeHtml(item.key)}" class="${item.key === this.#navKey && !this.#query ? "active" : ""}">${item.label}</button>`).join("")}</nav>
      ${this.#message ? `<div class="notice">${escapeHtml(this.#message)}</div>` : ""}${this.#error ? `<div class="error">${escapeHtml(this.#error)}</div>` : ""}
      ${this.#loading && !this.#items.length ? '<div class="empty">MakerWorld-Modelle werden geladen …</div>' : this.#items.length ? '<div class="grid" id="grid"></div>' : '<div class="empty">Keine MakerWorld-Modelle gefunden.</div>'}
      ${this.#items.length && (this.#hasMore || this.#loading) ? `<div class="load-row"><button class="load-more" id="load-more" type="button" ${this.#loading ? "disabled" : ""}>${this.#loading ? "Wird geladen …" : "Weitere Modelle laden"}</button></div>` : ""}`;

    const grid = page.querySelector<HTMLElement>("#grid");
    if (grid) grid.replaceChildren(...this.#items.map((item) => this.#card(item)));
    page.querySelector<HTMLFormElement>("#search-form")?.addEventListener("submit", (event) => {
      event.preventDefault();
      this.#query = page.querySelector<HTMLInputElement>("#query")?.value.trim() || "";
      void this.#load(true);
    });
    page.querySelectorAll<HTMLButtonElement>("[data-nav]").forEach((button) => button.addEventListener("click", () => {
      this.#navKey = button.dataset.nav || "Trending";
      this.#query = "";
      void this.#load(true);
    }));
    page.querySelector<HTMLButtonElement>("#load-more")?.addEventListener("click", () => void this.#load(false));
    if (this.#detailLoading || this.#detail) this.#renderDialog();
  }

  #card(item: MakerWorldDesign): HTMLElement {
    const card = document.createElement("article");
    card.className = "card";
    card.tabIndex = 0;
    const image = document.createElement("div");
    image.className = "image";
    image.append(this.#image(item.thumbnail_url, item.title));
    const menu = document.createElement("button");
    menu.type = "button";
    menu.className = "menu";
    menu.textContent = "⋮";
    menu.addEventListener("click", (event) => {
      event.stopPropagation();
      const bounds = menu.getBoundingClientRect();
      this.#openContext(new MouseEvent("contextmenu", { clientX: bounds.right, clientY: bounds.bottom }), item);
    });
    const body = document.createElement("div");
    body.className = "body";
    body.innerHTML = `<div class="title">${escapeHtml(item.title)}</div><div class="creator">Von ${escapeHtml(item.creator)}</div><div class="stats"><span>♥ ${numberLabel(item.stats.likes)}</span><span>⇩ ${numberLabel(item.stats.downloads)}</span><span>💬 ${numberLabel(item.stats.comments)}</span></div><div class="tags">${item.tags.slice(0, 3).map((tag) => `<span class="tag">${escapeHtml(tag)}</span>`).join("")}</div><div class="card-actions"><button type="button" data-action="details">Details</button><button type="button" data-action="slicer">Slicer</button></div>`;
    body.querySelector<HTMLButtonElement>("[data-action='details']")?.addEventListener("click", (event) => {
      event.stopPropagation();
      void this.#openDetail(item.id);
    });
    body.querySelector<HTMLButtonElement>("[data-action='slicer']")?.addEventListener("click", (event) => {
      event.stopPropagation();
      void this.#quickTransfer(item, "slicer");
    });
    card.append(menu, image, body);
    card.addEventListener("click", () => void this.#openDetail(item.id));
    card.addEventListener("contextmenu", (event) => this.#openContext(event, item));
    card.addEventListener("keydown", (event) => {
      if (event.key === "Enter") void this.#openDetail(item.id);
      if (event.key === "ContextMenu" || (event.shiftKey && event.key === "F10")) {
        const bounds = card.getBoundingClientRect();
        this.#openContext(new MouseEvent("contextmenu", { clientX: bounds.left + 24, clientY: bounds.top + 24 }), item);
      }
    });
    return card;
  }

  #image(url: string | null | undefined, title: string): HTMLElement {
    if (!url) {
      const fallback = document.createElement("div");
      fallback.className = "fallback";
      fallback.textContent = "◇";
      return fallback;
    }
    const image = document.createElement("img");
    image.src = url;
    image.alt = title;
    image.loading = "lazy";
    image.referrerPolicy = "no-referrer";
    image.addEventListener("error", () => {
      image.replaceWith(this.#image(null, title));
    }, { once: true });
    return image;
  }

  async #openDetail(designId: string): Promise<void> {
    this.#detailLoading = true;
    this.#detail = null;
    this.#error = "";
    this.#renderDialog();
    try {
      const [detail, library] = await Promise.all([
        this.#api.detail(designId),
        this.#galleryApi.list("", "", false),
      ]);
      this.#detail = detail;
      this.#folders = library.tree;
      const selected = detail.instances.find((instance) => instance.is_default) ?? detail.instances[0] ?? null;
      this.#selectedInstanceId = selected?.id ?? "";
      this.#selectedPlateId = selected?.plates[0]?.id ?? "";
      this.#selectedImage = detail.images[0] || detail.thumbnail_url || "";
    } catch (error) {
      this.#error = errorMessage(error);
      this.#closeDialog();
      this.#render();
      return;
    } finally {
      this.#detailLoading = false;
      this.#renderDialog();
    }
  }

  #renderDialog(): void {
    this.#root.querySelector(".overlay")?.remove();
    this.#root.querySelector(".close")?.remove();
    if (!this.#detailLoading && !this.#detail) return;
    const overlay = document.createElement("div");
    overlay.className = "overlay";
    const dialog = document.createElement("section");
    dialog.className = "dialog";
    if (this.#detailLoading || !this.#detail) {
      dialog.innerHTML = '<div class="dialog-loading">MakerWorld-Details und Druckprofile werden geladen …</div>';
    } else {
      this.#buildDialog(dialog, this.#detail);
    }
    const close = document.createElement("button");
    close.type = "button";
    close.className = "close";
    close.textContent = "×";
    close.addEventListener("click", () => this.#closeDialog());
    overlay.addEventListener("click", (event) => {
      if (event.target === overlay) this.#closeDialog();
    });
    overlay.append(dialog);
    this.#root.append(overlay, close);
  }

  #buildDialog(dialog: HTMLElement, detail: MakerWorldDetail): void {
    const images = detail.images.length ? [...detail.images] : detail.thumbnail_url ? [detail.thumbnail_url] : [];
    const instance = this.#selectedInstance(detail);
    const visual = document.createElement("section");
    visual.className = "visual";
    const thumbs = document.createElement("div");
    thumbs.className = "thumbs";
    for (const url of images) {
      const button = document.createElement("button");
      button.type = "button";
      button.className = `thumb${url === this.#selectedImage ? " active" : ""}`;
      button.append(this.#image(url, detail.title));
      button.addEventListener("click", () => {
        this.#selectedImage = url;
        this.#renderDialog();
      });
      thumbs.append(button);
    }
    const stage = document.createElement("div");
    stage.className = "stage";
    stage.append(this.#image(this.#selectedImage || detail.thumbnail_url, detail.title));
    visual.append(thumbs, stage);

    const side = document.createElement("aside");
    side.className = "side";
    side.innerHTML = `<h2>${escapeHtml(detail.title)}</h2><div class="by">Von ${escapeHtml(detail.creator)}</div><div class="detail-stats"><span class="detail-stat">♥ ${numberLabel(detail.stats.likes)}</span><span class="detail-stat">⇩ ${numberLabel(detail.stats.downloads)}</span><span class="detail-stat">💬 ${numberLabel(detail.stats.comments)}</span><span class="detail-stat">Drucke ${numberLabel(detail.stats.prints)}</span></div><div class="description">${escapeHtml(detail.description || "Keine Beschreibung verfügbar.")}</div><div class="detail-tags">${detail.tags.map((tag) => `<span class="tag">${escapeHtml(tag)}</span>`).join("")}</div><section class="instance-section"><h3>Druckprofile und Platten</h3><div class="instance-list" id="instances"></div><div class="plates" id="plates"></div></section><div class="target"><label>Zielordner<select id="folder">${this.#folders.map((folder) => `<option value="${escapeHtml(folder.path)}">${escapeHtml(folder.path || "Hauptordner")}</option>`).join("")}</select></label><label>Dateiname<input id="filename" value="${escapeHtml(safeFileName(`${detail.title}${instance ? ` - ${instance.title}` : ""}`))}"></label><label>Ausgewählte Platte<input value="${escapeHtml(this.#selectedPlate(detail)?.name || "Alle Platten des Druckprofils")}" disabled></label></div><div class="actions" id="actions"></div>`;
    const instanceHost = side.querySelector<HTMLElement>("#instances")!;
    instanceHost.replaceChildren(...detail.instances.map((item) => this.#instanceCard(item)));
    const plateHost = side.querySelector<HTMLElement>("#plates")!;
    if (instance) plateHost.replaceChildren(...instance.plates.map((plate) => this.#plateCard(plate)));
    const actions = side.querySelector<HTMLElement>("#actions")!;
    const save = this.#actionButton("In Galerie speichern", "primary wide", () => void this.#saveToGallery());
    const cad = this.#actionButton("CAD-Studio", "", () => void this.#transferSelected("studio"));
    const slicer = this.#actionButton("Slicer", "", () => void this.#transferSelected("slicer"));
    const download = this.#actionButton("Original-3MF herunterladen", "wide", () => void this.#downloadSelected());
    const official = this.#actionButton("Auf MakerWorld öffnen ↗", "wide", () => {
      window.open(detail.model_url, "_blank", "noopener,noreferrer");
    });
    const disabled = !instance || Boolean(this.#busy);
    save.disabled = disabled;
    cad.disabled = disabled;
    slicer.disabled = disabled;
    download.disabled = disabled;
    actions.append(save, cad, slicer, download, official);
    dialog.append(visual, side);
  }

  #instanceCard(instance: MakerWorldInstance): HTMLElement {
    const card = document.createElement("article");
    card.className = `instance${instance.id === this.#selectedInstanceId ? " active" : ""}`;
    card.append(this.#image(instance.thumbnail_url, instance.title));
    const content = document.createElement("div");
    content.innerHTML = `<strong>${escapeHtml(instance.title)}</strong><small>${escapeHtml(instance.printer_model || "Druckermodell offen")}${instance.nozzle_diameter ? ` · ${escapeHtml(instance.nozzle_diameter)} mm` : ""} · ${instance.plate_count} Platte${instance.plate_count === 1 ? "" : "n"}</small>`;
    card.append(content);
    card.addEventListener("click", () => {
      this.#selectedInstanceId = instance.id;
      this.#selectedPlateId = instance.plates[0]?.id ?? "";
      if (instance.images[0]) this.#selectedImage = instance.images[0];
      this.#renderDialog();
    });
    return card;
  }

  #plateCard(plate: MakerWorldPlate): HTMLElement {
    const button = document.createElement("button");
    button.type = "button";
    button.className = `plate${plate.id === this.#selectedPlateId ? " active" : ""}`;
    if (plate.thumbnail_url) button.append(this.#image(plate.thumbnail_url, plate.name));
    const body = document.createElement("div");
    body.className = "plate-body";
    body.innerHTML = `<strong>${escapeHtml(plate.name)}</strong><small>${durationLabel(plate.print_time_seconds)}${plate.weight_grams ? ` · ${plate.weight_grams} g` : ""}</small>`;
    button.append(body);
    button.addEventListener("click", () => {
      this.#selectedPlateId = plate.id;
      if (plate.thumbnail_url) this.#selectedImage = plate.thumbnail_url;
      this.#renderDialog();
    });
    return button;
  }

  #actionButton(label: string, className: string, action: () => void): HTMLButtonElement {
    const button = document.createElement("button");
    button.type = "button";
    button.textContent = this.#busy ? "Wird verarbeitet …" : label;
    button.className = className;
    button.addEventListener("click", action);
    return button;
  }

  #selectedInstance(detail = this.#detail): MakerWorldInstance | null {
    if (!detail) return null;
    return detail.instances.find((item) => item.id === this.#selectedInstanceId)
      ?? detail.instances.find((item) => item.is_default)
      ?? detail.instances[0]
      ?? null;
  }

  #selectedPlate(detail = this.#detail): MakerWorldPlate | null {
    const instance = this.#selectedInstance(detail);
    return instance?.plates.find((plate) => plate.id === this.#selectedPlateId)
      ?? instance?.plates[0]
      ?? null;
  }

  async #quickTransfer(item: MakerWorldDesign, target: WorkspaceFileTarget): Promise<void> {
    if (this.#busy) return;
    this.#busy = item.id;
    this.#message = "";
    this.#error = "";
    this.#render();
    try {
      const detail = await this.#api.detail(item.id);
      const instance = detail.instances.find((entry) => entry.is_default) ?? detail.instances[0];
      if (!instance) throw new Error("Für dieses Modell ist kein herunterladbares Druckprofil verfügbar.");
      await this.#transfer(instance, detail.title, target);
    } catch (error) {
      this.#error = errorMessage(error);
      this.#busy = "";
      this.#render();
    }
  }

  async #transferSelected(target: WorkspaceFileTarget): Promise<void> {
    const detail = this.#detail;
    const instance = this.#selectedInstance();
    if (!detail || !instance || this.#busy) return;
    this.#busy = instance.id;
    this.#renderDialog();
    try {
      await this.#transfer(instance, detail.title, target);
    } catch (error) {
      this.#error = errorMessage(error);
      this.#busy = "";
      this.#renderDialog();
      this.#render();
    }
  }

  async #transfer(instance: MakerWorldInstance, title: string, target: WorkspaceFileTarget): Promise<void> {
    const format = target === "studio" ? "stl" : "3mf";
    const file = await this.#api.downloadInstance(instance.id, format, `${title} - ${instance.title}`);
    queueWorkspaceFile(target, file);
    this.#busy = "";
    this.#closeDialog(false);
    this.dispatchEvent(new CustomEvent(target === "studio" ? "gallery-open-studio" : "gallery-open-slicer", {
      bubbles: true,
      composed: true,
      detail: { designId: instance.design_id, instanceId: instance.id, fileName: file.name },
    }));
  }

  async #saveToGallery(): Promise<void> {
    const detail = this.#detail;
    const instance = this.#selectedInstance();
    const dialog = this.#root.querySelector<HTMLElement>(".dialog");
    if (!detail || !instance || !dialog || this.#busy) return;
    const folder = dialog.querySelector<HTMLSelectElement>("#folder")?.value ?? "";
    const filename = dialog.querySelector<HTMLInputElement>("#filename")?.value.trim() || safeFileName(detail.title);
    this.#busy = instance.id;
    this.#renderDialog();
    try {
      let saved;
      try {
        saved = await this.#api.saveInstance(instance.id, folder, filename, false);
      } catch (error) {
        if (!errorMessage(error).toLocaleLowerCase("de-DE").includes("exist") || !window.confirm("Im Zielordner existiert bereits eine gleichnamige Datei. Überschreiben?")) throw error;
        saved = await this.#api.saveInstance(instance.id, folder, filename, true);
      }
      this.#message = `${saved.name} wurde in der Galerie gespeichert.`;
      this.#busy = "";
      this.#closeDialog(false);
      this.#render();
    } catch (error) {
      this.#error = errorMessage(error);
      this.#busy = "";
      this.#renderDialog();
    }
  }

  async #downloadSelected(): Promise<void> {
    const detail = this.#detail;
    const instance = this.#selectedInstance();
    if (!detail || !instance || this.#busy) return;
    this.#busy = instance.id;
    this.#renderDialog();
    try {
      const file = await this.#api.downloadInstance(instance.id, "3mf", `${detail.title} - ${instance.title}`);
      const url = URL.createObjectURL(file);
      const anchor = document.createElement("a");
      anchor.href = url;
      anchor.download = file.name;
      anchor.click();
      window.setTimeout(() => URL.revokeObjectURL(url), 1000);
    } catch (error) {
      this.#error = errorMessage(error);
    } finally {
      this.#busy = "";
      this.#renderDialog();
      this.#render();
    }
  }

  #openContext(event: MouseEvent, item: MakerWorldDesign): void {
    const actions: ContextMenuAction[] = [
      { label: "Modelldetails öffnen", run: () => this.#openDetail(item.id) },
      { label: "An Slicer übergeben", run: () => this.#quickTransfer(item, "slicer") },
      { label: "Im CAD-Studio öffnen", run: () => this.#quickTransfer(item, "studio") },
      {
        label: "Auf MakerWorld öffnen",
        separatorBefore: true,
        run: () => {
          window.open(item.model_url, "_blank", "noopener,noreferrer");
        },
      },
      {
        label: "MakerWorld-Link kopieren",
        run: async () => {
          await navigator.clipboard?.writeText(item.model_url);
          this.#message = "MakerWorld-Link wurde kopiert.";
          this.#render();
        },
      },
    ];
    openContextMenu(event, actions);
  }

  #closeDialog(render = true): void {
    this.#detail = null;
    this.#detailLoading = false;
    this.#selectedInstanceId = "";
    this.#selectedPlateId = "";
    this.#selectedImage = "";
    this.#root.querySelector(".overlay")?.remove();
    this.#root.querySelector(".close")?.remove();
    if (render) this.#render();
  }
}

if (!customElements.get("ultimate-3d-makerworld-workspace")) {
  customElements.define("ultimate-3d-makerworld-workspace", Ultimate3DMakerWorldWorkspace);
}